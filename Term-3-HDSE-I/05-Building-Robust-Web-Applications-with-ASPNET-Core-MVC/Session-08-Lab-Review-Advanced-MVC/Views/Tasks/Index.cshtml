@model List<TaskItem>
<h1>@ViewData["Title"]</h1>

@if (TempData["Message"] != null)
{
    <p style="color:green">@TempData["Message"]</p>
}

<table border="1" cellpadding="6">
    <tr><th>Task</th><th>Status</th><th></th></tr>
    @foreach (var task in Model)
    {
        <partial name="_TaskRow" model="task" />
    }
</table>
<p>JSON version: <a href="/api/tasks">/api/tasks</a></p>
